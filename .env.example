# Copy this file to `.env` (next to docker-compose.yml) before `docker compose up`.
# docker-compose.yml reads these values.
#
# IMPORTANT — DDS + domain MUST match the robot, or the UI connects to rosbridge
# but sees ZERO robot topics (every panel stays empty). FastDDS and CycloneDDS
# do not talk to each other. The OpenAMRobot platform runs CycloneDDS on
# domain 0, so use:
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_DOMAIN_ID=0

# Set to 1 to force a colcon rebuild of the UI ROS workspace on container start.
OPENAMR_REBUILD_ON_START=0

# --- Frontend dev only (npm run dev from a separate PC) ---
# When the UI is served by Flask on the robot (:5050) the browser auto-resolves
# rosbridge to the same host, so this is NOT needed for the deployed case. It is
# only the fallback for `npm run dev` on http://localhost:3000. Point it at the
# robot's IP for PC development:
# REACT_APP_ROSBRIDGE_IP=172.17.201.29
